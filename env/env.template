# =============================================================================
# Keycloak Kubernetes — Environment Configuration
# =============================================================================
# Copy this file and customize:
#   cp env/env.template env/env
#
# Then generate Kubernetes secrets and realm config:
#   ./kc-setup.sh env/env                # Dev  (writes to base/)
#   ./kc-setup.sh env/env overlays/prod  # Prod (writes to overlays/prod/)
#
# Or use the defaults below without an env file:
#   ./kc-setup.sh
# =============================================================================

export KEYCLOAK_REALM_NAME=app
export KEYCLOAK_NAMESPACE=keycloak
export KEYCLOAK_SECRET_NAME=keycloak-realm

# -- Admin Credentials --------------------------------------------------------
# Master realm admin user. Stored in the keycloak-admin Kubernetes Secret.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -- Application Client -------------------------------------------------------
# Pre-configured OIDC client in the imported "app" realm.
# See base/realm.template.json for the full realm definition.
APP_CLIENT_ID=app-client
APP_CLIENT_SECRET=app-client-secret

# -- Database -----------------------------------------------------------------
# The dev overlay uses embedded H2; these are only consumed by the prod overlay.
# Stored in the keycloak-db-credentials Kubernetes Secret.
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_DB_NAME=keycloak

# -- Reference: Manifest-Level Settings ---------------------------------------
# The following are set directly in the deployment manifests, not via this file.
# Edit base/keycloak-deployment.yaml or the overlay patches to change them.
#
# KC_HEALTH_ENABLED=true
# KC_METRICS_ENABLED=true
# KC_HTTP_MANAGEMENT_PORT=9000
